#!name = 📺 BiliBili: 🛡️ ADBlock + BBZQ
#!desc = 基于 BiliUniverse ADBlock 原始 Surge 模块，补充暂停广告、首页卡片类型与标题关键词过滤。
#!openUrl = http://boxjs.com/#/app/BiliBili.ADBlock
#!author = BiliUniverse,BBZQ,jiegebuy
#!homepage = https://github.com/jiegebuy/egern-ubol/tree/main/bilibili
#!icon = https://github.com/BiliUniverse/ADBlock/raw/main/src/assets/icon_rounded.png
#!category = 🪐 BiliUniverse
#!version = 0.6.24-bbzq.3
#!arguments = Splash:true,Feed.AD:true,Feed.Activity:false,Feed.Vertical:false,Feed.BlockUpLiveList:"",Feed.Story:true,Feed.Filter:false,Feed.FilterTypes:"picture,game,live,ketang,vertical,large",Feed.TitleKeywords:"",Search.AD:true,Search.HotSearch:true,PGC.AD:true,Xlive.AD:true,Dynamic.HotTopics:true,Dynamic.MostVisited:false,Dynamic.MostVisitedLiveOnly:false,Dynamic.AdCard:true,View.AD:true,DM.Command:false,DM.Colorful:false,Reply.AD:true,LogLevel:"WARN"
#!arguments-desc = Splash: [开屏] 去除广告\nFeed.AD: [推荐] 去除广告\nFeed.Activity: [推荐] 去除活动大图\nFeed.Vertical: [推荐] 去除竖屏视频\nFeed.BlockUpLiveList: [推荐] 屏蔽指定 UP 主直播推广，多个 UID 用英文逗号分隔\nFeed.Story: [首页] 去除短视频流广告\nFeed.Filter: [BBZQ] 启用额外首页卡片与关键词过滤\nFeed.FilterTypes: [BBZQ] picture、game、live、ketang、vertical、large，英文逗号分隔\nFeed.TitleKeywords: [BBZQ] 标题关键词黑名单，英文逗号分隔\nSearch.AD: [搜索] 去除广告\nSearch.HotSearch: [搜索] 去除热搜\nPGC.AD: [番剧电影] 去除广告\nXlive.AD: [直播] 去除广告\nDynamic.HotTopics: [动态] 去除热门话题\nDynamic.MostVisited: [动态] 去除最常访问\nDynamic.MostVisitedLiveOnly: [动态] 最常访问仅保留直播\nDynamic.AdCard: [动态] 去除广告卡片\nView.AD: [视频] 去除详情页广告\nDM.Command: [弹幕] 去除交互式弹幕\nDM.Colorful: [弹幕] 替换彩色弹幕\nReply.AD: [评论] 去除广告\nLogLevel: OFF、ERROR、WARN、INFO、DEBUG 或 ALL\n暂停广告为固定功能，随模块启用。

[URL Rewrite]
# 暂停广告：广告配置域名与暂停页请求
^https?:\/\/cm\.bili(bili\.com|api\.net)\/ - reject
# gRPC/内部服务无法伪造同格式响应，只拒绝明确的暂停页服务请求
(?i)^https?:\/\/grpc\.bili(bili\.com|api\.net)\/.*(pause|paused|pause_page|paused_page|pausedpage|pause_ad|ad_pause)(\/|\?|$) - reject
# iOS 9.9.x 将暂停广告面板改为 View/PlayPause gRPC 方法；该响应只负责商业暂停面板，拒绝后播放器仍可正常播放。
^https?:\/\/grpc\.biliapi\.net\/bilibili\.app\.viewunite\.v1\.View\/PlayPause$ - reject
# 去除搜索中的默认关键词
^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ - reject

[Map Local]
# 暂停页通常是 JSON 请求；返回成功空数据比 reject 更接近 BBZQ 的 null 结果，避免客户端回退到广告面板
(?i)^https?:\/\/(api|app)\.bili(bili\.com|api\.net)\/.*(pause|paused|pause_page|paused_page|pausedpage|pause_ad|ad_pause)(\/|\?|$) data-type=text data="{\"code\":0,\"message\":\"0\",\"data\":{}}" header="Content-Type: application/json"
^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words data-type=text data="{}" header="application/json"
^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr data-type=text data="{}" header="application/json"
^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/mix_uplist data-type=text data="{}" header="application/json"
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Flash data-type=text data="{}" header="application/json"
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash data-type=text data="{}" header="application/json"
^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? data-type=text data="{}" header="application/json"
^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? header="content-type: application/json" data-type=text data="{"code":0,"data":{"closeType":"close_win","container":[],"showTime":""},"message":"success"}"

[Body Rewrite]
http-response-jq ^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\? 'del(.data.payment)'

[Script]
📺 BiliBili.ADBlock.feed.index.request.json = type=http-request, pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/feed\/index\?, engine=webview, script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.24/request.bundle.js, argument=Splash="{{{Splash}}}"&Feed.AD="{{{Feed.AD}}}"&Feed.Activity="{{{Feed.Activity}}}"&Feed.Vertical="{{{Feed.Vertical}}}"&Feed.BlockUpLiveList="{{{Feed.BlockUpLiveList}}}"&Feed.Story="{{{Feed.Story}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.ADBlock.response.json = type=http-response, pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/(splash\/(brand\/list|event\/list2|list|show)|feed\/index(\/story)?|search\/square), requires-body=1, engine=webview, script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.24/response.bundle.js, argument=Splash="{{{Splash}}}"&Feed.AD="{{{Feed.AD}}}"&Feed.Activity="{{{Feed.Activity}}}"&Feed.Vertical="{{{Feed.Vertical}}}"&Feed.BlockUpLiveList="{{{Feed.BlockUpLiveList}}}"&Feed.Story="{{{Feed.Story}}}"&Search.AD="{{{Search.AD}}}"&Search.HotSearch="{{{Search.HotSearch}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.ADBlock.feed.extra.response.json = type=http-response, pattern=^https?:\/\/app\.bili(bili\.com|api\.net)\/x\/v2\/feed\/index\?, requires-body=1, engine=webview, script-path=https://raw.githubusercontent.com/jiegebuy/egern-ubol/main/bilibili/scripts/feed-filter.compat.js, argument=Feed.Filter="{{{Feed.Filter}}}"&Feed.FilterTypes="{{{Feed.FilterTypes}}}"&Feed.TitleKeywords="{{{Feed.TitleKeywords}}}"
📺 BiliBili.ADBlock.web.feed.response.json = type=http-response, pattern=^https?:\/\/api\.bilibili\.com\/x\/web-interface\/wbi\/index\/top\/feed\/rcmd\?, requires-body=1, engine=webview, script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.24/response.bundle.js, argument=Feed.AD="{{{Feed.AD}}}"&Feed.Activity="{{{Feed.Activity}}}"&Feed.Vertical="{{{Feed.Vertical}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.ADBlock.pgc.page.response.json = type=http-response, pattern=^https?:\/\/api\.bili(bili\.com|api\.net)\/pgc\/page\/(bangumi|cinema\/tab\?), requires-body=1, engine=webview, script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.24/response.bundle.js, argument=PGC.AD="{{{PGC.AD}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.ADBlock.app-room.response.json = type=http-response, pattern=^https?:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoByRoom, requires-body=1, engine=webview, script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.24/response.bundle.js, argument=Xlive.AD="{{{Xlive.AD}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.ADBlock.view.response.grpc = type=http-response, pattern=^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.(view|viewunite)\.v1\.View\/(View|TFInfo|RelatesFeed)$, requires-body=1, binary-body-mode=1, engine=webview, max-size=262144, script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.24/response.bundle.js, argument=View.AD="{{{View.AD}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.ADBlock.dynamic.response.grpc = type=http-response, pattern=^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.dynamic\.v2\.Dynamic\/Dyn(All|Video)$, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.24/response.bundle.js, argument=Dynamic.HotTopics="{{{Dynamic.HotTopics}}}"&Dynamic.MostVisited="{{{Dynamic.MostVisited}}}"&Dynamic.MostVisitedLiveOnly="{{{Dynamic.MostVisitedLiveOnly}}}"&Dynamic.AdCard="{{{Dynamic.AdCard}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.ADBlock.playurl.response.grpc = type=http-response, pattern=^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.playurl\.v1\.PlayURL\/PlayView$, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.24/response.bundle.js, argument=View.AD="{{{View.AD}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.ADBlock.search.response.grpc = type=http-response, pattern=^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.24/response.bundle.js, argument=Search.AD="{{{Search.AD}}}"&Search.HotSearch="{{{Search.HotSearch}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.ADBlock.dm.response.grpc = type=http-response, pattern=^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.community\.service\.dm\.v1\.DM\/(DmView|DmSegMobile), requires-body=1, binary-body-mode=1, engine=webview, script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.24/response.bundle.js, argument=DM.Command="{{{DM.Command}}}"&DM.Colorful="{{{DM.Colorful}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.ADBlock.interface.response.grpc = type=http-response, pattern=^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.24/response.bundle.js, argument=LogLevel="{{{LogLevel}}}"
📺 BiliBili.ADBlock.reply.response.grpc = type=http-response, pattern=^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.main\.community\.reply\.v1\.Reply\/MainList, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.24/response.bundle.js, argument=Reply.AD="{{{Reply.AD}}}"&LogLevel="{{{LogLevel}}}"
📺 BiliBili.ADBlock.pgc.response.grpc = type=http-response, pattern=^https:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.pgc\.gateway\.player\.v2\.PlayURL\/PlayView$, requires-body=1, binary-body-mode=1, engine=webview, script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.24/response.bundle.js, argument=PGC.AD="{{{PGC.AD}}}"&LogLevel="{{{LogLevel}}}"

[MITM]
hostname = %APPEND% manga.bilibili.com, api.live.bilibili.com, api.vc.bilibili.com, app.bilibili.com, app.biliapi.net, api.bilibili.com, api.biliapi.net, grpc.bilibili.com, grpc.biliapi.net
h2 = true
